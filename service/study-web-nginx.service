[Unit]
Description=GitOps Nginx Reverse Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=forking

ExecStart=/usr/sbin/nginx -c /home/study-web/.config/systemd/user/git-ops/nginx/default.conf
ExecReload=/usr/sbin/nginx -s reload -c /home/study-web/.config/systemd/user/git-ops/nginx/default.conf
ExecStop=/usr/sbin/nginx -s quit -c /home/study-web/.config/systemd/user/git-ops/nginx/default.conf

PIDFile=/home/study-web/.config/systemd/user/git-ops/nginx/run/nginx.pid

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
