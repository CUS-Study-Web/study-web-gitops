[Unit]
Description=Study Web Backend Production Service
After=network-online.target
Wants=network-online.target

[Service]
Restart=always
EnvironmentFile=%h/.config/systemd/user/git-ops/backend.env
WorkingDirectory=%h/.config/systemd/user/git-ops

ExecStart=/usr/bin/podman-compose -p studyweb-be-prod -f docker.be.prod.compose.yml --env-file backend.env up
ExecStop=/usr/bin/podman-compose -p studyweb-be-prod -f docker.be.prod.compose.yml --env-file backend.env down

[Install]
WantedBy=default.target
