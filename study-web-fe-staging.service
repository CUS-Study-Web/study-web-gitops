[Unit]
Description=Study Web Frontend Staging Container
After=network.target

[Service]
Environment="FE_STAGING_PORT=8080"
EnvironmentFile=-%h/.config/systemd/user/study-web-fe-staging.env
Restart=always
ExecStartPre=-/usr/bin/podman rm -f study-web-fe-staging
ExecStartPre=/usr/bin/podman pull ghcr.io/cus-study-web/frontend:staging
ExecStart=/usr/bin/podman run --name study-web-fe-staging --net slirp4netns -p ${FE_STAGING_PORT}:80 ghcr.io/cus-study-web/frontend:staging
ExecStop=/usr/bin/podman stop study-web-fe-staging

[Install]
WantedBy=default.target
