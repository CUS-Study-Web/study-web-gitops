[Unit]
Description=Study Web Frontend Staging Container
After=network.target

[Service]
Environment="FE_STAGING_PORT=8080"
Environment="BACKEND_API_URL=http://116.118.6.22:58888"
Restart=always
ExecStartPre=-/usr/bin/podman rm -f study-web-fe-staging
ExecStartPre=/usr/bin/podman pull ghcr.io/cus-study-web/frontend:staging
ExecStart=/usr/bin/podman run --name study-web-fe-staging \
  --net slirp4netns \
  -p 127.0.0.1:${FE_STAGING_PORT}:80 \
  -e BACKEND_API_URL=${BACKEND_API_URL} \
  ghcr.io/cus-study-web/frontend:staging
ExecStop=/usr/bin/podman stop study-web-fe-staging

[Install]
WantedBy=default.target