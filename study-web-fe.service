[Unit]
Description=Study Web Frontend Production Container
After=network.target

[Service]
Environment="FE_PROD_PORT=8081"
Environment="BACKEND_API_URL=http://116.118.6.22"
Restart=always
ExecStartPre=-/usr/bin/podman rm -f study-web-fe
ExecStartPre=/usr/bin/podman pull ghcr.io/cus-study-web/frontend:latest
ExecStart=/usr/bin/podman run --name study-web-fe \
  --net slirp4netns \
  -p 127.0.0.1:${FE_PROD_PORT}:80 \
  -e BACKEND_API_URL=${BACKEND_API_URL} \
  ghcr.io/cus-study-web/frontend:latest
ExecStop=/usr/bin/podman stop study-web-fe

[Install]
WantedBy=default.target